    plot(timey,slopearr_nonlin(maskex(i),22)*timey.^fitexpyarr(22),'-b')


    plot(timearr(maskex(i),:),displarr(maskex(i),:), '-.b')
    fprintf('lidstress = %d \n', buoyarr(maskex(i)))

end

