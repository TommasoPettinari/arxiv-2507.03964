%% FIGURE for exp dependence on radius


figure(32)

scatter(sizearr,bestexparr, 90, buoyarr, 'o','filled')
hold on

masknan = ~isnan(bestexparr);

%fit trend to exponent: goes down with size, consistent with sinking to
%rigid boundary (should be around 0.5 though, for 40mm)

f = fit(sizearr(masknan),bestexparr(masknan),'poly1');
plot(f,sizearr,bestexparr)

